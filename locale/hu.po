#, python-format
msgctxt "model:ir.message,text:msg_invoice_in_missing_ref"
msgid "The invoices \"%(invoices)s\" haven't got reference."
msgstr "A(z) „%(invoices)s” számláknak nincs hivatkozása."

#, python-format
msgctxt "model:ir.message,text:msg_invoices_sii"
msgid ""
"The next invoices are related with SII books:\n"
"%(invoices)s.\n"
"If you edit them take care if you need to update again to SII"
msgstr ""
"A következő számlák SII könyvekhez kapcsolódnak:\n"
"%(invoices)s.\n"
"Módosításukkor ellenőrizze, szükséges-e ismét frissíteni az SII-adatokat."

msgctxt "model:ir.message,text:msg_invoices_sii_pending"
msgid "The next invoices are related with SII books on draft state."
msgstr "A következő számlák tervezett állapotú SII könyvekhez kapcsolódnak."

msgctxt "model:ir.message,text:msg_missing_certificate"
msgid ""
"There isn't a certificate deffined in the account configuration for the SII."
msgstr "A könyvelési beállításokban nincs megadva SII-tanúsítvány."

msgctxt "model:ir.message,text:msg_missing_fernet_key"
msgid "Missing Fernet key configuration"
msgstr "Hiányzik a Fernet-kulcs beállítása"

#, python-format
msgctxt "model:ir.message,text:msg_missing_nif"
msgid "The party of the invoice %(invoice)s must has a valid Tax Identifier."
msgstr ""
"A(z) %(invoice)s számla partnerének érvényes adóazonosítóval kell "
"rendelkeznie."

#, python-format
msgctxt "model:ir.message,text:msg_missing_sii_keys"
msgid "The invoice \"%(invoice)s\" haven't got the necessary SII keys filled."
msgstr "A(z) „%(invoice)s” számlán nincsenek kitöltve a szükséges SII-kódok."

#, python-format
msgctxt "model:ir.message,text:msg_report_duplicated_invoice"
msgid "Invoice \"%(invoice)s\" is duplicated on SII Report \"%(report)s\"."
msgstr ""
"A(z) „%(invoice)s” számla többször szerepel a(z) „%(report)s” SII "
"bevallásban."

#, python-format
msgctxt "model:ir.message,text:msg_report_wrong_invoice_state"
msgid "Invoice \"%(invoice)s\" must be posted, paid or refunded."
msgstr ""
"A(z) „%(invoice)s” számlának könyvelt, kifizetett vagy visszatérített "
"állapotúnak kell lennie."

#, python-format
msgctxt "model:ir.message,text:msg_service_message"
msgid "%(message)s"
msgstr "%(message)s"

#, python-format
msgctxt "model:ir.message,text:msg_set_simplified_invoice"
msgid ""
"The parties of the invoices \"%(invoices)s\" has not set the SII Identfier "
"as 'Simplified Invoice', but the invoice SII operation key is set as "
"'Simplified Invoice (ticket)' or 'Invoice summary entry'. The invoices will "
"be send to AEAT without destination identification."
msgstr ""
"A(z) „%(invoices)s” számlák partnereinek SII-azonosítója nem „Egyszerűsített"
" számla”, de a számla SII-ügyletkódja „Egyszerűsített számla (nyugta)” vagy "
"„Számla-összesítő bejegyzés”. A számlák címzettazonosító nélkül kerülnek az "
"AEAT-hoz."

#, python-format
msgctxt "model:ir.message,text:msg_set_simplified_party"
msgid ""
"The parties of the invoices \"%(invoices)s\" has the SII Identfier as "
"'Simplified Invoice'. The SII operation key will be switched to 'Simplified "
"Invoice (ticket)' or 'Invoice summary entry' as appropriate, and the "
"invoices will be send to AEAT without destination identification."
msgstr ""
"A(z) „%(invoices)s” számlák partnereinek SII-azonosítója „Egyszerűsített "
"számla”. Az SII-ügyletkód ennek megfelelően „Egyszerűsített számla (nyugta)”"
" vagy „Számla-összesítő bejegyzés” lesz, és a számlák címzettazonosító "
"nélkül kerülnek az AEAT-hoz."

#, python-format
msgctxt "model:ir.message,text:msg_sii_operation_key_wrong"
msgid ""
